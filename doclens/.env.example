# Copy to .env and load it into your shell:  set -a; source .env; set +a
# Any OpenAI-compatible server works: vLLM on Kaggle (tunnel), a local server, or a hosted API.
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=none
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# How the server wants a JSON schema: json_schema (OpenAI, vLLM, llama-server) or llama_cpp (llama-cpp-python's server)
LLM_SCHEMA_STYLE=json_schema
# Seconds to wait for one completion; raise it for local CPU models
LLM_TIMEOUT=60

# 1 = air-gapped: only local models, and any outbound network call that is not loopback/LAN is refused.
OFFLINE=0

# Used by eval/metrics.py to turn seconds per page into $ per 1k pages. State it as an assumption wherever you quote it.
GPU_HOURLY_USD=0.35
